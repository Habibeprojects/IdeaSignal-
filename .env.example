# Reddit OAuth app credentials
# Create a "script" type app at https://www.reddit.com/prefs/apps
REDDIT_CLIENT_ID=your_reddit_client_id
REDDIT_CLIENT_SECRET=your_reddit_client_secret
REDDIT_USER_AGENT=IdeaSignal/0.1 by your_reddit_username

# AI provider - Anthropic-compatible endpoint (via @anthropic-ai/sdk)
# Swapping providers only requires changing these three values, no code changes.
AI_API_KEY=your_ai_provider_api_key
AI_BASE_URL=https://tabitoken.com
AI_MODEL=claude-opus-5

# Safety/compliance default:
# metadata = AI only sees Reddit titles + public metadata, not post/comment bodies.
# content  = AI may receive short post/comment excerpts. Use only if your approved Reddit use permits it.
REDDIT_AI_ANALYSIS_MODE=metadata

# Optional local/demo mode. Set true to test the UI without any API keys.
USE_MOCK_DATA=false
